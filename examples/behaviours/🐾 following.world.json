   "thing": {
    "kind": "text",
    "text": "FOLLOWING\n\nThe pointer device delivers\n[across | away].\n\nA thing's bird takes\n[set | position | [x | z]].\n\nThe box the device gives is\nexactly the box the message\nwants, so the robot only has\nto put one inside the other."
   },
   "x": -1.45,
